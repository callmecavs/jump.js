    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
